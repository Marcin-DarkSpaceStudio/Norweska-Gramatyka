{
  "name": "norweska-gramatyka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "concurrently \"npm:watch\" \"npm:serve\"",
    "serve": "vite --host 127.0.0.1",
    "watch": "chokidar \"src/kit/**/*.kit\" \"src/styles/**/*.css\" \"src/scripts/**/*.js\" -c \"npm run build\" --initial --polling --poll-interval 300"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.0.0",
    "terser": "^5.0.0",
    "vite": "^6.0.0"
  }
}
